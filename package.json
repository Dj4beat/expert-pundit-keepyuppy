{
  "name": "expert-pundit-keepyuppy",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build && node scripts/build-offline.mjs && node scripts/export-portable.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:browser": "playwright test",
    "lint": "eslint src tests scripts --max-warnings 0",
    "format": "prettier --write src tests scripts docs *.json *.ts index.html README.md eslint.config.js",
    "format:check": "prettier --check src tests scripts docs *.json *.ts index.html README.md eslint.config.js",
    "vendor:phaser": "node scripts/vendor-phaser.mjs",
    "screenshots": "node scripts/capture-screenshots.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@playwright/test": "1.62.1",
    "@types/node": "22.20.3",
    "eslint": "^9.36.0",
    "globals": "^16.4.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.45.0",
    "vite": "^7.1.9",
    "vitest": "^3.2.4",
    "esbuild": "0.28.2",
    "@types/three": "0.180.0"
  },
  "dependencies": {
    "three": "0.180.0"
  }
}
